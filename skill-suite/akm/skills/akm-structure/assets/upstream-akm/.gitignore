# ── Instance data: your knowledge stays local ──────────────────
# The repo distributes the system (99-system, adapters, templates).
# Everything stored in the layers below is your private instance.

# Inbox: temporary migration/intake holding area — never tracked.
00-inbox/**
!00-inbox/**/
!00-inbox/**/.gitkeep
!00-inbox/README.md

# Safety net: build artifacts must never enter the knowledge vault.
**/node_modules/**

# Safety net: large binary assets live OUTSIDE the vault. See
# 99-system/EXTERNAL-ASSETS.md for the mirrored-path convention.
*.wav
*.mp3
*.flac
*.m4a
*.aac
*.mp4
*.mov
*.mkv
*.avi
*.pdf
*.pptx
*.ppt
*.key

10-sources/**
!10-sources/**/
!10-sources/**/.gitkeep

20-knowledge/**
!20-knowledge/**/
!20-knowledge/**/.gitkeep

30-context/**
!30-context/**/
!30-context/**/.gitkeep

40-memory/**
!40-memory/**/
!40-memory/**/.gitkeep

50-procedures/**
!50-procedures/**/
!50-procedures/**/.gitkeep

60-actions/**
!60-actions/**/
!60-actions/**/.gitkeep

70-evaluation/**
!70-evaluation/**/
!70-evaluation/**/.gitkeep

80-outputs/**
!80-outputs/**/
!80-outputs/**/.gitkeep

90-archive/**
!90-archive/**/
!90-archive/**/.gitkeep

# ── Maintainer-local files (build plan, personal mappings) ─────
/99-system/INDEX.local.md
/99-system/MAPPING-*.md
/99-system/EXTERNALIZED-LARGE-FILES.md
/PLAN*.md

# ── Generated exports ─────────────────────────────────────────
/dist/
/graphify-docgraph/
/graphify-out/
/scripts/graphify-out/
/tmp/

# ── Local Obsidian app state ──────────────────────────────────
/.obsidian/

# ── OS noise ───────────────────────────────────────────────────
.DS_Store
